# No credentials in this file. scripts/setup-local.py creates ignored secret files.
# Environment is read by Compose; all listeners remain on loopback.
HUB_PORT=18080
HUB_PUBLIC_BASE_URL=http://127.0.0.1:18080
# Optional: absolute directory created by setup-local.py
# HUB_SECRETS_DIR=/absolute/path/to/.local/secrets
# G9 production also loads infra/compose.g9.yml and a private google_config file.
# Public registration stays disabled in that file until the G10 operations gate.
# HUB_GOOGLE_ENABLED=1
