# Only a public MCP endpoint belongs in VITE configuration; never put secrets here.
VITE_MCP_URL=https://goodmcp.si/mcp
# Dev proxy defaults to http://127.0.0.1:18080.
# Set GOODMCP_API_ORIGIN in the shell only when the backend authority also matches.
# Web session/Google routes are same-origin; VITE_OAUTH_ISSUER is no longer used.
